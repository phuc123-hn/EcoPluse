# Bản mẫu: sao chép thành .env khi chạy máy mình, còn trên Railway thì nhập vào mục Variables.
# File này CÓ thể đưa lên git vì không chứa giá trị thật.

# --- Bắt buộc ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
EARTHDATA_TOKEN=
NEXT_PUBLIC_MAPTILER_KEY=
HN_ADMIN_EMAIL=
HN_ADMIN_PASSWORD=

# --- Chỉ đặt trên Railway ---
# (Code tự nhận ra Railway và bật cookie Secure + tắt /docs, nhưng vẫn nên đặt rõ ràng)
PRODUCTION=1
COOKIE_SECURE=1
# Số proxy CỦA BẠN đứng trước app, dùng để lấy đúng IP người dùng khi giới hạn tần suất:
#   chỉ Railway = 1 (mặc định khi chạy Railway); dùng Vercel rewrite phía trước Railway = 2; chạy máy mình = 0
TRUSTED_PROXIES=1
HN_DB=/data/hydronisar.db
CACHE_DIR=/data/cache

# --- Tùy chọn ---
# LIMITED_DAYS=7              # phiên "chế độ chỉ xem" (Quên mật khẩu) sống bao nhiêu ngày
# MAX_RENDER_JOBS=2           # số cảnh vệ tinh được xử lý cùng lúc
# TTS_GOOGLE_FALLBACK=1       # bật giọng Google Dịch dự phòng (sẽ gửi nội dung tin nhắn sang Google). Mặc định TẮT
# RENDER_DEBUG=1              # trả thêm danh sách dataset HDF5 khi lỗi (chỉ để gỡ lỗi)
# HN_ADMIN_PHONE=
# NOMINATIM_CONTACT=email-lien-he@example.com
# TTS_VOICE=vi-VN-HoaiMyNeural
# PROVINCE_NAME_FIELD=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
